{
    "schemaVersion": "1.0",
    "solution": {
        "name": "SichtTestHelper",
        "version": "0.2.0"
    },
    "settings": {
        "standards": {
            "cxx_standard": 20
        },
        "defaults": {
            "library_type": "INTERFACE",
            "executable_type": "GUI"
        },
        "sources": {
            "mode": "explicit"
        }
    },
    "externals": {
        "Qt6": {
            "description": "Qt6 UI Framework",
            "skip": false,
            "system": true,
            "package": "Qt6",
            "components": [ "Core", "Gui", "Widgets", "Network" ],
            "hints": [ "${QT_ROOT}" ]
        }
    },
    "libraries": [
        {
            "name": "SichttestSteuerung",
            "description": "DLL zur Steuerung der geprüften Anwendung: Kanal zum Tester über eine benannte Pipe, ohne Qt",
            "skip": false,
            "type": "SHARED",
            "output_name": "SichttestSteuerung1",
            "path": "projects/libs/SichttestSteuerung/src",
            "defines": [ "STS_PRODUKT=\"{version}\"" ],
            "dependencies": [],
            "externals": [],
            "platform": "windows"
        }
    ],
    "executables": [
        {
            "name": "Gegenprobe",
            "description": "Anwendung ohne Qt für den Selbsttest: lädt die DLL zur Laufzeit und verbindet sich mit dem Tester",
            "skip": false,
            "type": "CONSOLE",
            "path": "projects/exec/Gegenprobe/src",
            "defines": [ "STS_PRODUKT=\"{version}\"" ],
            "dependencies": [],
            "externals": [],
            "platforms": [ "windows" ]
        },
        {
            "name": "GegenprobeQt",
            "description": "Qt-Anwendung für den Selbsttest: benutzt sichttest_steuerung_qt.hpp wie eine geprüfte Anwendung",
            "skip": false,
            "type": "CONSOLE",
            "path": "projects/exec/GegenprobeQt/src",
            "dependencies": [],
            "externals": [ "Qt6" ],
            "platforms": [ "windows" ]
        },
        {
            "name": "Sichttest",
            "description": "Fenster zum Abhaken einer Sichttest-Liste: liest Markdown-Checklisten und *.testprotokoll.json, schreibt Testlog, Report und Screenshots neben die Liste",
            "skip": false,
            "type": "GUI",
            "path": "projects/exec/Sichttest/src",
            "defines": [ "STS_PRODUKT=\"{version}\"" ],
            "dependencies": [],
            "externals": [ "Qt6" ],
            "platforms": [ "windows", "linux", "macos" ]
        }
    ],
    "packages": [
        {
            "name": "sichttest",
            "archive": "sichttest-v{version}-win64",
            "config": "Release",
            "contents": [
                { "to": "include", "headers_of": "SichttestSteuerung",
                  "files": [ "sichttest_steuerung.h", "sichttest_steuerung.hpp", "sichttest_steuerung_qt.hpp" ] },
                { "to": "bin", "binary_of": "SichttestSteuerung" },
                { "to": "sichttest", "output_dir_of": "Sichttest", "exclude": [ "*.pdb", "*.ilk" ] }
            ],
            "version_file": "packaging/VERSION.in"
        }
    ],
    "apps": [],
    "tests": []
}
